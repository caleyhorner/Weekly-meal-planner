# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres. Vercel adds DATABASE_URL (and DATABASE_URL_UNPOOLED) automatically when you
# connect a Neon database from the Vercel Marketplace.
DATABASE_URL=postgres://postgres@localhost:5432/mealplanner

# The shared household passphrase used to sign in (not case-sensitive).
HOUSEHOLD_PASSPHRASE=

# Random string of at least 32 characters used to sign the login cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Claude API key from console.anthropic.com, used to read recipes from photos, links and text.
ANTHROPIC_API_KEY=

# Optional: override the model used to read recipes.
# RECIPE_MODEL=claude-opus-5-5

# Vercel adds this automatically when you connect a Blob store. Without it, photos are
# saved to ./.uploads for local development.
# BLOB_READ_WRITE_TOKEN=

# Optional: "Send to OpenClaw" button on the shopping list. The full URL of OpenClaw's
# webhook (reachable from the internet, e.g. via Tailscale Funnel) and its hooks.token.
# OPENCLAW_HOOK_URL=https://your-machine.your-tailnet.ts.net/hooks/agent
# OPENCLAW_HOOK_TOKEN=
